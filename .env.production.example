DB_USERNAME=aegis
DB_PASSWORD=replace-with-a-strong-random-password
AEGIS_VIEWER_API_KEY=replace-with-a-long-random-viewer-key
AEGIS_ADMIN_API_KEY=replace-with-a-long-random-admin-key
AEGIS_EXECUTION_CONFIRMATION_TOKEN=replace-with-a-separate-long-random-token
AEGIS_LIVE_EXECUTION_ENABLED=false
BINANCE_INGESTION_ENABLED=true
ML_LABEL_HORIZON_MINUTES=15
ML_NEUTRAL_RETURN_THRESHOLD=0.001
ML_VOLATILITY_LABEL_MULTIPLIER=0.50
ML_PREDICTION_RESOLUTION_DELAY_MS=60000
ML_MODEL_HEALTH_DELAY_MS=300000
ML_HEALTH_MINIMUM_SAMPLE_SIZE=30
ML_PROMOTION_MIN_BALANCED_ACCURACY=0.55
ML_PROMOTION_MIN_MACRO_F1=0.50
ML_PROMOTION_MIN_DIRECTIONAL_PRECISION=0.52
ML_PROMOTION_MIN_VALIDATION_SAMPLES=150
ML_PROMOTION_MAX_CALIBRATION_ERROR=0.15
ML_PROMOTION_MIN_WORST_FOLD_BALANCED_ACCURACY=0.40
